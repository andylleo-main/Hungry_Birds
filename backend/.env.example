# Local development only. Anything other than "development" - including
# leaving this out - is treated as production, which is what makes the safe
# defaults safe.
ENVIRONMENT=development

# Postgres connection (Railway injects DATABASE_URL automatically; for local dev use:
# postgresql+asyncpg://user:password@localhost:5432/hungry_birds)
DATABASE_URL=postgresql+asyncpg://hungry_birds:hungry_birds@localhost:5432/hungry_birds

# Redis connection (Railway injects REDIS_URL automatically)
REDIS_URL=redis://localhost:6379/0

# Resend (transactional email for OTP codes)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Hungry Birds <onboarding@resend.dev>

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_EMAIL_DOMAIN=bitmesra.ac.in

# Makes this address an admin at startup, creating the account if it does not
# exist. It breaks a deadlock on a fresh deployment: the admin panel needs an
# admin, promote_admin.py only promotes someone who has already signed in,
# signing in needs an OTP email, and configuring email is itself an admin task.
#
# Grants the role and nothing else - no password, no session - so on its own it
# is not a way in; pair it with ADMIN_PASSWORD_HASH when email does not work yet.
# Idempotent, so leaving it set is harmless. Unset it once you can sign in.
BOOTSTRAP_ADMIN_EMAIL=

# Enables POST /api/auth/admin/login, so an admin can sign in with a password
# instead of waiting on an OTP email - which matters because the admin is the
# account you need when email is the thing that is broken. Empty means that
# endpoint does not exist. Generate with:
#   PYTHONPATH=. python scripts/set_admin_password.py
ADMIN_PASSWORD_HASH=

# When true, OTP codes are also returned in the API response so you can log
# in during local dev without a working Resend account. Ignored unless
# ENVIRONMENT=development as well, so copying this into production is inert.
OTP_DEBUG_ECHO=true

# Cloudinary (image uploads, client uploads directly using a signed request
# minted by the backend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=hungry_birds

# Empty means no CORS headers at all, which is right in production: the backend
# serves the web app, so every call is same-origin. In development this is
# filled in automatically with Vite's localhost ports.
CORS_ORIGINS=

# How many reverse proxies sit in front of the app. Railway is exactly 1. Set to
# 0 when running directly with nothing in front, so X-Forwarded-For - which a
# caller can forge - is ignored when finding the address to rate limit.
TRUSTED_PROXY_COUNT=0

# Request limits. The per-endpoint limits live in app/core/limits.py; these are
# the blanket ones applied to everything.
MAX_REQUEST_BYTES=262144
GLOBAL_RATE_LIMIT_REQUESTS=300
GLOBAL_RATE_LIMIT_SECONDS=60

# --- Push notifications (Firebase Cloud Messaging) ---------------------------
# Both blank means push is off: orders still arrive over the websocket and on
# the next queue fetch, there is just no notification on a locked phone.
#
# FCM_PROJECT_ID is the Firebase project id, e.g. hungry-birds-1a2b3.
# FIREBASE_SERVICE_ACCOUNT_JSON is the whole service-account key file, pasted as
# a single line. Firebase console -> Project settings -> Service accounts ->
# Generate new private key. It is a credential: it belongs in Railway's
# variables, never in the repo.
FCM_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Payments (Cashfree) -----------------------------------------------------
# Blank means payments are off: checkout answers 503 and the webhook 404s, so
# nothing can be charged and nothing unverified is accepted.
#
# "cashfree" or "mock". Mock confirms every payment instantly without charging
# anything or contacting anybody, so the stall queue, notifications, rider
# assignment and the handover code can be walked through before the gateway
# credentials exist. It also disables the Cashfree webhook, because there is no
# secret to verify signatures against.
#
# On a deployment students can reach, this is free food. The checkout page shows
# an unmissable banner while it is on and the server logs a warning every boot,
# but the only real protection is turning it off - and the default is "cashfree"
# precisely so that nobody ends up here by omission.
PAYMENTS_MODE=cashfree

# App id and secret come from the Cashfree dashboard. The secret is BOTH the API
# credential and the key Cashfree signs webhooks with, so it never belongs
# anywhere near the browser bundle.
#
# PUBLIC_BASE_URL is this deployment's own public address, used to build the
# webhook and return URLs handed to Cashfree - e.g.
# https://your-service.up.railway.app
#
# Set CASHFREE_ENV=production only once the account has passed Cashfree's KYC.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
PUBLIC_BASE_URL=
