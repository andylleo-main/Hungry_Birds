# Never let local secrets or a local virtualenv into the image. Railway builds
# from a git clone so .env shouldn't exist there anyway, but a local
# `docker build` would happily bake it in.
.env
.env.*
!.env.example
.venv/

__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/

# Not needed at runtime.
tests/
pytest.ini
requirements-dev.txt
